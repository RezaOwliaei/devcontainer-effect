{
	// Derived from the folder name (e.g. "my-app") rather than hardcoded, so
	// every project cloned from this template gets a distinct name for free
	// — no manual edit, and no collisions between concurrently-open
	// containers in the VS Code UI or `docker ps`. Override with a literal
	// string here if the folder name is unhelpful (e.g. shared across
	// worktrees) or you want something nicer.
	"name": "${localWorkspaceFolderBasename}",

	"build": {
		"dockerfile": "Dockerfile"
	},

	"remoteUser": "bun",

	// Same reasoning applied to the actual Docker container name: "name"
	// above only labels the VS Code UI, it does NOT set the container's
	// name in `docker ps` / Docker Desktop — without this, every dev
	// container gets an autogenerated hash-suffixed name that's impossible
	// to tell apart at a glance when several are running at once. This
	// makes them sortable/filterable by prefix instead.
	//
	// --cap-add=SYS_PTRACE + --security-opt seccomp=unconfined: THIS BRANCH
	// ONLY, for the strace-based #39972 hunt in scaffold.sh. Docker's
	// default seccomp profile blocks the `ptrace` syscall outright, even
	// for a container tracing its own child process as a non-root user —
	// without these, `strace` fails immediately with "Operation not
	// permitted". Not something to carry back to main.
	"runArgs": [
		"--name", "devcontainer-${localWorkspaceFolderBasename}",
		"--cap-add=SYS_PTRACE",
		"--security-opt", "seccomp=unconfined"
	],

	// Named volume for Bun's install cache (~/.bun/install/cache). Without
	// this the cache lives in the disposable container layer, so every
	// rebuild re-downloads every package from the registry. The volume
	// survives rebuilds and is shared across every project built from this
	// base image, so the first `bun install` in a *second* project is
	// already warm.
	//
	// Second volume for Claude Code's config/auth (~/.claude, keyed by
	// CLAUDE_CONFIG_DIR below). Unlike the Bun cache, this one is keyed by
	// ${devcontainerId} — a stable per-container-config id VS Code
	// provides — so it's NOT shared across projects: each project gets its
	// own Claude session/auth/settings, and one project's volume never
	// leaks into another's. Without this mount, signing in to Claude Code
	// wouldn't survive a container rebuild.
	"mounts": [
		"source=bun-install-cache,target=/home/bun/.bun/install/cache,type=volume",
		"source=claude-code-config-${devcontainerId},target=/home/bun/.claude,type=volume"
	],

	// Passes your host git identity in as plain env vars rather than baking
	// it into the Dockerfile (which would freeze a stale copy in a file
	// meant to be a generic template) or bind-mounting ~/.gitconfig (which
	// hard-fails container creation if that file doesn't exist on the
	// host). ${localEnv:...} resolves to an empty string when the host var
	// isn't set — never a build/creation failure — so scaffold.sh's
	// fallback identity still covers hosts that never set these. Requires
	// a one-time host-side export, e.g. in ~/.zshrc:
	//   export HOST_GIT_NAME="$(git config --global user.name)"
	//   export HOST_GIT_EMAIL="$(git config --global user.email)"
	//
	// CLAUDE_CONFIG_DIR redirects Claude Code's config dir to the mounted
	// volume above. Claude Code also keeps a second file, ~/.claude.json
	// (OAuth account, personal MCP servers, per-project trust), OUTSIDE
	// ~/.claude by default — without this var, that file would still land
	// in the disposable container layer and get lost on rebuild even with
	// the volume mounted.
	"containerEnv": {
		"HOST_GIT_NAME": "${localEnv:HOST_GIT_NAME}",
		"HOST_GIT_EMAIL": "${localEnv:HOST_GIT_EMAIL}",
		"CLAUDE_CONFIG_DIR": "/home/bun/.claude"
	},

	// Full auto-scaffold, not just `bun init -y`: on a brand-new project
	// (package.json missing) this writes package.json (Effect/tsgo/oxlint
	// deps pinned to their "latest"/"rc" dist-tags), tsconfig.json,
	// .oxlintrc.json, .gitignore, AGENTS.md, .vscode/settings.json, and an
	// index.ts entrypoint; vendors Effect's own source at repos/effect via
	// git subtree for agent reference; then runs `bun install`. Every step
	// is idempotent (checks before writing), so it's also safe to re-run on
	// rebuild against an existing project — see .devcontainer/scaffold.sh
	// for the exact logic and .devcontainer/templates/ for the file
	// contents it copies from.
	"postCreateCommand": "bash .devcontainer/scaffold.sh",

	"customizations": {
		"vscode": {
			// These are baked in rather than left for each project to opt
			// into — every project built from this template is an Effect
			// project, so all five are always wanted:
			// - oven.bun-vscode: Bun runtime support
			// - oxc.oxc-vscode: oxlint/oxfmt integration (this template's
			//   projects use oxlint, not eslint/prettier)
			// - TypeScriptTeam.native-preview: speaks tsgo's native protocol.
			//   Required because `effect-tsgo patch` replaces node_modules/
			//   typescript with tsgo (TS 7), which has no lib/tsserver.js —
			//   the built-in TS extension can't find it and silently falls
			//   back to its own bundled TypeScript. See .vscode/settings.json
			//   for the settings this extension needs.
			// - effectful-tech.effect-vscode ("Effect Dev Tools"): fiber/span/
			//   metrics debugging panels. No required settings — all its
			//   contributed settings (effect.devServer.port,
			//   effect.metrics.pollInterval, etc.) are debug-tuning knobs with
			//   working defaults.
			// - anthropic.claude-code: VS Code panel for the Claude Code CLI
			//   installed in the Dockerfile. Shares the same ~/.claude config
			//   (see CLAUDE_CONFIG_DIR above) as running `claude` directly in
			//   the integrated terminal — either works.
			"extensions": [
				"oven.bun-vscode",
				"oxc.oxc-vscode",
				"TypeScriptTeam.native-preview",
				"effectful-tech.effect-vscode",
				"anthropic.claude-code"
			]
			// No "settings" block: .vscode/settings.json is bind-mounted and
			// wins over customizations.vscode.settings, so it's the one
			// place to edit, not a second driftable copy. scaffold.sh writes
			// it from .devcontainer/templates/settings.json on first run.
		}
	}

	// "workspaceFolder" intentionally omitted — defaults to
	// /workspaces/<folder-name>, which is fine for a single-project container.
}
